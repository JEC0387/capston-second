<?xml version="1.0" encoding="utf-8"?>
<!--
   자동 백업 규칙 (안드로이드 11 이하). 12 이상은 data_extraction_rules.xml 을 쓴다.
   - db_sync.xml : 이 폰의 기기 번호 + 서버로 보낼 대기열(체형 측정 숫자 포함)
       → 새 폰에 복원되면 두 폰이 같은 기기 번호를 써서 서버 옷장을 서로 덮어쓰고,
         체형 숫자가 구글 백업에 남으므로 백업하지 않는다.
   - privacy_consent.xml : 체형 사진 이용 동의는 기기마다 새로 받는다.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="db_sync.xml" />
    <exclude domain="sharedpref" path="privacy_consent.xml" />
</full-backup-content>
