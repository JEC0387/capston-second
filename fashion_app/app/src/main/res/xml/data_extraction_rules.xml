<?xml version="1.0" encoding="utf-8"?>
<!--
   백업 · 기기 이전 규칙 (안드로이드 12 이상). 이유는 backup_rules.xml 설명과 같다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="db_sync.xml" />
        <exclude domain="sharedpref" path="privacy_consent.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="db_sync.xml" />
        <exclude domain="sharedpref" path="privacy_consent.xml" />
    </device-transfer>
</data-extraction-rules>
