<?xml version="1.0" encoding="utf-8"?>
<!--
   백업 · 기기 이전 규칙 (안드로이드 12 이상). 이유는 backup_rules.xml 설명과 같다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="db_sync.xml" />
        <exclude domain="sharedpref" path="data_auth.xml" />
    <exclude domain="sharedpref" path="restore_stage_wardrobe_store.xml" />
    <exclude domain="sharedpref" path="restore_stage_sample_wear_history.xml" />
    <exclude domain="sharedpref" path="restore_stage_wear_log_store.xml" />
    <exclude domain="sharedpref" path="restore_stage_profile_store.xml" />
    <exclude domain="sharedpref" path="restore_stage_user_prefs.xml" />
    <exclude domain="sharedpref" path="restore_stage_product_interests.xml" />
    <exclude domain="sharedpref" path="restore_stage_taste_preference.xml" />
    <exclude domain="sharedpref" path="restore_stage_style_preference.xml" />
    <exclude domain="sharedpref" path="restore_stage_saved_outfits.xml" />
    <exclude domain="sharedpref" path="restore_stage_outfit_plans.xml" />
    <exclude domain="sharedpref" path="restore_stage_recommendation_log.xml" />
    <exclude domain="sharedpref" path="restore_stage_db_sync.xml" />

        <exclude domain="sharedpref" path="privacy_consent.xml" />
        <exclude domain="sharedpref" path="manual_body_measurements.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="db_sync.xml" />
        <exclude domain="sharedpref" path="data_auth.xml" />
    <exclude domain="sharedpref" path="restore_stage_wardrobe_store.xml" />
    <exclude domain="sharedpref" path="restore_stage_sample_wear_history.xml" />
    <exclude domain="sharedpref" path="restore_stage_wear_log_store.xml" />
    <exclude domain="sharedpref" path="restore_stage_profile_store.xml" />
    <exclude domain="sharedpref" path="restore_stage_user_prefs.xml" />
    <exclude domain="sharedpref" path="restore_stage_product_interests.xml" />
    <exclude domain="sharedpref" path="restore_stage_taste_preference.xml" />
    <exclude domain="sharedpref" path="restore_stage_style_preference.xml" />
    <exclude domain="sharedpref" path="restore_stage_saved_outfits.xml" />
    <exclude domain="sharedpref" path="restore_stage_outfit_plans.xml" />
    <exclude domain="sharedpref" path="restore_stage_recommendation_log.xml" />
    <exclude domain="sharedpref" path="restore_stage_db_sync.xml" />

        <exclude domain="sharedpref" path="privacy_consent.xml" />
        <exclude domain="sharedpref" path="manual_body_measurements.xml" />
    </device-transfer>
</data-extraction-rules>
