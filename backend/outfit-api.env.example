# Disabled by default; no credentials, legal retention default or production URL.
# Requires the existing DataAuth account database via deployment secret storage.
# Do not enable DB_AUTO_CREATE or run migrations against production for this service.
OUTFIT_VTON_ENABLED=false
OUTFIT_VTON_DEPLOYMENT_APPROVED=false
OUTFIT_VTON_POLICY_VERSION=
OUTFIT_VTON_RETENTION_SECONDS=0
OUTFIT_VTON_STORAGE=
OUTFIT_VTON_TIMEOUT_SECONDS=240
OUTFIT_VTON_MAX_JOBS_PER_DAY=2
# Local synthetic tests only. Android always requires HTTPS.
OUTFIT_VTON_LOOPBACK_HTTP=false
# Model/provider settings are in outfit-vton.env.example, also disabled by default.
