# Documentation only; never commit real keys or enable without explicit approvals.
# Select this provider separately with OUTFIT_VTON_PROVIDER=genlook.
GENLOOK_ENABLED=false
GENLOOK_DEPLOYMENT_APPROVED=false
GENLOOK_PAID_CALLS_APPROVED=false
GENLOOK_PRIVACY_APPROVED=false
GENLOOK_PREPAID_CONFIRMED=false
GENLOOK_AUTO_TOPUP_DISABLED_CONFIRMED=false
GENLOOK_API_KEY=
GENLOOK_TERMS_REVIEW_ID=
GENLOOK_PRIVACY_REVIEW_ID=
GENLOOK_COST_REVIEW_ID=
GENLOOK_LEDGER_DIR=
# Default keeps existing sequential journals. Optional paired mode requires its
# own reviewed deployment contract, never repurpose/reset an existing spend ledger.
GENLOOK_MODE=sequential-3
# Optional: clothing-pair-then-shoes = clothing pair (2 credits), shoes (1 credit).
# Both modes reserve 3 credits, even after cancel/uncertain response.
# Explicit reviewed unit-price ceiling in micro-USD (1 USD=1000000); no price inferred.
GENLOOK_MAX_TOTAL_CREDITS=0
GENLOOK_UNIT_PRICE_MICROUSD=0
GENLOOK_MAX_TOTAL_MICROUSD=0
GENLOOK_TIMEOUT_SECONDS=240
