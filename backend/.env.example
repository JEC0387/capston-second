# Supabase PostgreSQL session-pooler URL. Keep the actual password only in backend/.env.
DATABASE_URL=
# Set true only to create tables in an empty development database; existing schemas need migrations.
DB_AUTO_CREATE=false
# Keep new-account registration closed until migration 005 and an approved rollout.
AUTH_REGISTRATION_ENABLED=false
# OpenWeatherMap key for live weather; an empty value makes weather endpoints return 503.
OWM_API_KEY=
NAVER_API_KEY_ID=
NAVER_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional paid AI try-on proxy. Keep disabled until HTTPS, private journal and
# per-user token hashes are configured as described in AI_TRYON_SETUP.md.
TRYON_ENABLED=false
FASHN_API_KEY=
TRYON_CLIENT_TOKEN_HASHES=
TRYON_USER_DAILY_LIMIT=3
TRYON_GLOBAL_DAILY_LIMIT=20
TRYON_JOURNAL_PATH=
