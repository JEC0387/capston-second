# Example only. No service or model is enabled by this file.
# The API's separate approval/auth/privacy settings must also be configured.
OUTFIT_VTON_GPU_ENABLED=false
OUTFIT_VTON_GPU_DEPLOYMENT_APPROVED=false
# Operator-staged complete local Diffusers bundle; do not use an HF repo URL.
OUTFIT_VTON_MODEL_BUNDLE=
# SHA256 of reviewed outfit.manifest.json, NOT a placeholder or model name hash.
OUTFIT_VTON_MANIFEST_SHA256=
# Private writable job directory outside uploads/static/Git.
OUTFIT_VTON_WORK_DIR=
# Set only after reviewing the full model/runtime and available GPU capacity.
OUTFIT_VTON_MIN_VRAM_GIB=0

# Runtime packages are not silently installed. A dedicated GPU venv/container
# must match every exact version in the operator-reviewed manifest:
# torch, diffusers, transformers, accelerate, safetensors, Pillow.
# Official model API: QwenImageEditPlusPipeline with image=[person,top,bottom,shoes].
# Model: https://huggingface.co/Qwen/Qwen-Image-Edit-2511 (Apache-2.0).
# Dependency/code/weight rights and full four-reference quality remain separate reviews.
